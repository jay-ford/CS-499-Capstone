{{!-- Displays the Travel page content. --}}

<div id="contents">
    <div class="box">
        <div>
            <div class="body">

                {{!-- Displays the Travel page heading. --}}
                <h1>Travel</h1>

                {{!-- Displays the available travel destinations. --}}
                <ul id="sites">

                    {{#each trips}}
                        <li>

                            <a href="/api/trips/{{this.code}}">
                                <img
                                    src="/images/{{this.image}}" alt="Travel destination: {{this.name}}">
                            </a>

                            <h2>
                                <a href="/api/trips/{{this.code}}">
                                    {{this.name}}
                                </a>
                            </h2>

                            {{{this.description}}}

                        </li>
                    {{/each}}

                </ul>

            </div>
        </div>
    </div>
</div>